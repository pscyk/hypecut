# Copy to ~/.config/hypecut/.env, or .env in your working directory.
ANTHROPIC_API_KEY=
# Optional provider: hypecut URL --provider kimi
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# Kimi Coding keys use: https://api.kimi.com/coding/v1
# CLIPPER_MODEL=claude-sonnet-4-6
# CLIPPER_WHISPER_MODEL=small
# CLIPPER_WHISPER_DEVICE=auto
# CLIPPER_WHISPER_COMPUTE=auto
# CLIPPER_VCODEC=auto
# HYPECUT_CACHE_DIR=/path/to/cache
# Optional LR-ASD checkout and isolated Python, for --reframe track:
# HYPECUT_ASD_DIR=/path/to/LR-ASD
# HYPECUT_ASD_PY=/path/to/asd-venv/bin/python
